---
// src/layouts/Base.astro
// -----------------------------------------------------------------------------
// Outer shell for every page: <head>, top navigation, footer, and the
// site-wide easter egg (↑ ↑ ↓ ↓ ← → ← → B A).
// -----------------------------------------------------------------------------
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;         // page title; omitted on the home page
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} | ${site.short}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Navigation. Plain names, so nobody has to decode a joke to find the blog.
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/shows/', label: 'Shows' },
  { href: '/games/', label: 'Games' },
  { href: '/friends/', label: 'Friends' },
  { href: '/about/', label: 'About' },
];
// Highlight the section we're in (e.g. /blog/2026-10-26/ is under /blog/).
const here = Astro.url.pathname;
const isCurrent = (href: string) => here.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- How links look when pasted into Discord, WhatsApp, iMessage -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Fonts. Bricolage's width axis (75–100) gives the condensed giant type. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Caveat:wght@500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <header class="wrap top">
      <a class="logo" href="/" aria-label="Home">Chits.</a>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="wrap bottom">
      <p class="dismissed" aria-hidden="true">Class dismissed.</p>
      <div class="small">
        <span>Office hours: any time, by <a href={`mailto:${site.email}`}>email</a>.</span>
        <a href={site.github} target="_blank" rel="noopener">GitHub</a>
        <span>© {new Date().getFullYear()} {site.name}</span>
      </div>
    </footer>

    <!-- Easter egg overlay. Hidden until the Konami code. -->
    <div class="detention" id="detention" hidden>
      <p class="pen">How did we get here?</p>
      <p class="hint">Press Esc, or click anywhere, to be forgiven.</p>
    </div>

    <style>
      /* ── Top bar ───────────────────────────────────────────────────────── */
      .top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        padding: 1.6rem 0;
      }
      .logo {
        font-family: var(--f-big);
        font-weight: 800;
        font-variation-settings: 'wdth' 75;
        font-size: 1.6rem;
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; font-family: var(--f-big); font-size: 1.02rem; }
      nav a { text-decoration: none; }
      @media (max-width: 480px) { nav { gap: 0.3rem 0.9rem; font-size: 0.95rem; } }
      nav a:hover { text-decoration: underline; text-decoration-color: var(--red); }
      /* Current section: underlined in red pen */
      nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-color: var(--red);
        text-decoration-thickness: 2px;
      }

      /* ── Footer: one more giant line, then the fine print ─────────────── */
      .bottom { margin-top: 9rem; padding-bottom: 2.5rem; }
      .dismissed {
        margin: 0;
        font-family: var(--f-big);
        font-weight: 800;
        font-variation-settings: 'wdth' 75;
        font-size: var(--s-huge);
        line-height: 0.85;
        letter-spacing: -0.035em;
        color: var(--rule);          /* quiet: big but barely there */
      }
      .small {
        display: flex; flex-wrap: wrap; gap: 0.4rem 1.75rem;
        margin-top: 1.5rem; padding-top: 1.25rem;
        border-top: 1px solid var(--rule);
        font-size: var(--s--1); color: var(--muted);
      }

      /* ── Easter egg ─────────────────────────────────────────────────────── */
      .detention {
        position: fixed; inset: 0; z-index: 50;
        display: grid; place-content: center; text-align: center;
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        cursor: pointer;
        animation: stamp 380ms cubic-bezier(0.2, 1.4, 0.4, 1);
      }
      .detention[hidden] { display: none; }
      .detention .pen {
        margin: 0;
        font-size: clamp(3.5rem, 14vw, 12rem);
        font-weight: 700;
        transform: rotate(-9deg);
      }
      .detention .hint { margin-top: 2rem; color: var(--muted); font-size: var(--s--1); }
      @keyframes stamp { from { transform: scale(1.25); opacity: 0; } to { transform: none; opacity: 1; } }
    </style>

    <script>
      // ── ↑ ↑ ↓ ↓ ← → ← → B A shows the detention overlay ──────────────────
      const overlay = document.getElementById('detention')!;
      const code = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
      let progress = 0;   // how many keys of the sequence have matched so far

      const hide = () => { overlay.hidden = true; };
      overlay.addEventListener('click', hide);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') return hide();
        // Advance on a match; on a miss restart (a miss may itself begin a new run).
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        progress = key === code[progress] ? progress + 1 : key === code[0] ? 1 : 0;
        if (progress === code.length) { progress = 0; overlay.hidden = false; }
      });
    </script>
  </body>
</html>
