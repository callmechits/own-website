---
// src/layouts/Section.astro
// -----------------------------------------------------------------------------
// Layout for every sub-page. The header repeats the section's own element
// tile from the home table, so you always know which "element" you're in.
// -----------------------------------------------------------------------------
import Base from './Base.astro';
import Tile from '../components/Tile.astro';
import { bySym } from '../data/elements';

interface Props {
  sym: string;           // which element this page is (e.g. 'Pr')
  title?: string;        // defaults to the element's name
  intro?: string;        // one-paragraph lede under the title
}

const { sym, title, intro } = Astro.props;
const el = bySym(sym);
const heading = title ?? el.name;
---
<Base title={heading} description={intro}>
  <header class="wrap head">
    <a class="back" href="/">Back to the table</a>
    <div class="row">
      <Tile n={el.n} sym={el.sym} name={el.name} cat={el.cat} size="lg" />
      <div>
        <h1>{heading}</h1>
        {intro && <p class="intro">{intro}</p>}
      </div>
    </div>
  </header>

  <main class="wrap body">
    <slot />
  </main>
</Base>

<style>
  .head { padding-top: 2rem; }
  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .row { display: flex; gap: 1.5rem; align-items: center; }
  .intro { margin: 0.6rem 0 0; max-width: 52ch; color: var(--muted); font-size: var(--step-1); line-height: 1.4; }
  .body { margin-top: 3.5rem; }

  @media (max-width: 560px) {
    .row { flex-direction: column; align-items: flex-start; }
  }
</style>
