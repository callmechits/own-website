---
// src/pages/friends.astro
// -----------------------------------------------------------------------------
// Element 10. Each friend is their own element tile. Data: src/data/friends.ts.
// Tiles cycle through the four line colours so the grid isn't monochrome.
// -----------------------------------------------------------------------------
import Section from '../layouts/Section.astro';
import Tile from '../components/Tile.astro';
import { friends } from '../data/friends';

const cats = ['work', 'life', 'media', 'links'];
---
<Section sym="Fr" intro="Everyone here picked their own element.">
  {friends.length === 0 ? (
    <p class="empty">No one yet. Add friends in <code>src/data/friends.ts</code> once they've said yes.</p>
  ) : (
    <ul class="grid">
      {friends.map((f, i) => (
        <li>
          <Tile sym={f.sym} name={f.name} cat={cats[i % cats.length]} href={f.href} external={!!f.href} />
          <p>{f.line}</p>
        </li>
      ))}
    </ul>
  )}
</Section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid;
          grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 2rem 1.25rem; }
  .grid p { margin: 0.6rem 0 0; font-size: var(--step--1); line-height: 1.45; }
  .empty { color: var(--muted); }
</style>
