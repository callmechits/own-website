---
// src/pages/blog/index.astro — element 7: every post, newest first.
import Section from '../../layouts/Section.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../data/posts';

const posts = await getPosts();
// Every tag in use, for the filter links at the top.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Section sym="Bl" intro="Something most days. Some of it is about maths; most of it is about life.">
  {tags.length > 0 && (
    <p class="tags">
      Filter by tag:
      {tags.map((t) => <a href={`/blog/tag/${t}/`}>{t}</a>)}
    </p>
  )}
  <PostList posts={posts} />
</Section>

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-bottom: 2.5rem;
          font-family: var(--font-display); font-size: var(--step--1); color: var(--muted); }
  .tags a { color: var(--ink); }
</style>
