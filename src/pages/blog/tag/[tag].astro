---
// src/pages/blog/tag/[tag].astro
// -----------------------------------------------------------------------------
// One page per tag. /blog/tag/life/ is the Life element; /blog/tag/math/ is
// Maths. Those two are always generated (even with no posts yet) so the home
// table never links to a 404.
// -----------------------------------------------------------------------------
import Section from '../../../layouts/Section.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../data/posts';

// Tags that have their own element tile on the home page.
const ELEMENT_TAGS: Record<string, string> = { life: 'Lf', math: 'Ma' };

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Set([...posts.flatMap((p) => p.data.tags), 'life', 'math']);
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
// Element tags use their own tile; any other tag borrows the Blog tile.
const sym = ELEMENT_TAGS[tag!] ?? 'Bl';
const title = sym === 'Bl' ? `Posts tagged “${tag}”` : undefined;
---
<Section sym={sym} title={title} intro={`${posts.length} post${posts.length === 1 ? '' : 's'} so far.`}>
  <PostList posts={posts} />
  <p class="all"><a href="/blog/">All posts</a></p>
</Section>

<style>
  .all { margin-top: 2.5rem; font-family: var(--font-display); font-size: var(--step--1); }
</style>
