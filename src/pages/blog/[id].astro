---
// src/pages/blog/[id].astro
// -----------------------------------------------------------------------------
// One page per post. getStaticPaths runs at build time and tells Astro which
// URLs to generate: one per file in src/content/blog/.
// -----------------------------------------------------------------------------
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, fmtDate, type Post } from '../../data/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Pass neighbours along so each post can link to the previous/next one.
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title}>
  <article class="wrap post">
    <a class="back" href="/blog/">All posts</a>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
        {post.data.mood && <span>Mood: {post.data.mood}</span>}
        {post.data.tags.map((t) => <a href={`/blog/tag/${t}/`}>{t}</a>)}
      </p>
    </header>

    <div class="content"><Content /></div>

    <nav class="pager" aria-label="More posts">
      {older ? <a href={`/blog/${older.id}/`}>Older: {older.data.title}</a> : <span></span>}
      {newer && <a href={`/blog/${newer.id}/`}>Newer: {newer.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .post { padding-top: 2rem; }
  .back { display: inline-block; margin-bottom: 2.5rem; font-family: var(--font-display);
          font-size: var(--step--1); color: var(--muted); }
  header { max-width: var(--measure); }
  h1 { font-size: var(--step-3); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0.8rem 0 0;
          font-family: var(--font-display); font-size: var(--step--1); color: var(--muted); }

  /* Long-form reading styles for rendered Markdown */
  .content { max-width: var(--measure); margin-top: 2.5rem; font-size: 1.125rem; line-height: 1.7; }
  .content :global(h2) { margin: 2.5rem 0 0.8rem; }
  .content :global(h3) { margin: 2rem 0 0.6rem; }
  .content :global(blockquote) { margin: 1.5rem 0; padding-left: 1.2rem;
                                 border-left: 3px solid var(--h-beta); color: var(--muted); }
  .content :global(pre) { margin: 1.5rem 0; }

  .pager { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
           max-width: var(--measure); margin-top: 4rem; padding-top: 1.25rem;
           border-top: 1px solid var(--rule); font-family: var(--font-display); font-size: var(--step--1); }
</style>
