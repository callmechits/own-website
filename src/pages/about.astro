---
// src/pages/about.astro
// -----------------------------------------------------------------------------
// Element 1. The résumé in prose form, plus contact. Experience and Awards
// tiles on the home page link to the #experience and #awards anchors here.
// -----------------------------------------------------------------------------
import Section from '../layouts/Section.astro';
import { site } from '../data/site';
---
<Section sym="Ch" title="About" intro="Computer science student at Purdue, Indianapolis, by way of Haldwani, Uttarakhand.">
  <div class="prose">
    <p>
      I like problems that have a right answer and take a long time to find it:
      olympiad maths, physics, and software that has to run in real time.
      This site is where the finished things go, along with the unfinished
      things, games, shows, and whatever I felt like writing that day.
    </p>
  </div>

  <section class="block">
    <h2>Education</h2>
    <dl>
      <dt>Purdue University, College of Science</dt>
      <dd>BS Computer Science, expected May 2030. Chess Club and Computer Science Club.</dd>
      <dt>Dikshant International School, Haldwani</dt>
      <dd>High school, 2022 to 2026. AP Calculus BC (5), AP Physics C: Mechanics (5).</dd>
    </dl>
  </section>

  <section class="block" id="experience">
    <h2>Experience</h2>
    <dl>
      <dt>Software development intern, Design O’ Web <span class="when">2024 to 2025</span></dt>
      <dd>Built mobile application components in Flutter for production apps.</dd>
      <dt>Independent researcher, AI ethics <span class="when">2025 to 2026</span></dt>
      <dd>Case studies on privacy, transparency, autonomy and fairness in AI; proposed an accountability-centred oversight framework.</dd>
    </dl>
  </section>

  <section class="block" id="awards">
    <h2>Awards</h2>
    <dl>
      <dt>Indian National Mathematical Olympiad <span class="when">2022, 2024, 2025</span></dt>
      <dd>Qualified three times; INMO Awardee in 2025.</dd>
      <dt>NAEST <span class="when">2025</span></dt>
      <dd>First in state and top 40 nationally (top 0.1%). Worked with Dr. H.C. Verma and in labs at IIT Kanpur.</dd>
    </dl>
  </section>

  <section class="block" id="contact">
    <h2>Contact</h2>
    <p>
      Email <a href={`mailto:${site.email}`}>{site.email}</a>,
      or find the code on <a href={site.github} target="_blank" rel="noopener">GitHub</a>.
    </p>
  </section>
</Section>

<style>
  .prose { max-width: var(--measure); font-size: var(--step-1); line-height: 1.5; }
  .block { margin-top: 3.5rem; max-width: var(--measure); }
  .block h2 { margin-bottom: 1rem; }
  dl { margin: 0; }
  dt { font-family: var(--font-display); font-weight: 600; margin-top: 1.25rem; }
  dt:first-child { margin-top: 0; }
  dd { margin: 0.2rem 0 0; }
  .when { font-weight: 400; color: var(--muted); margin-left: 0.5rem; font-size: var(--step--1); }
</style>
