---
// src/pages/projects.astro
// -----------------------------------------------------------------------------
// Element 3. Renders src/data/projects.ts. Edit that file, not this one.
// -----------------------------------------------------------------------------
import Section from '../layouts/Section.astro';
import { projects, statusLabel } from '../data/projects';
---
<Section sym="Pr" intro="Stability ratings are honest. Unstable means still being built.">
  <ol class="list">
    {projects.map((p) => (
      <li class="project" data-status={p.status}>
        <div class="top">
          <h2>{p.name}</h2>
          <span class="status">{statusLabel[p.status]}</span>
        </div>
        <p class="meta">{p.when}. {p.stack.join(', ')}.</p>
        <p class="summary">{p.summary}</p>
        {p.points && p.points.length > 0 && (
          <ul class="points">{p.points.map((pt) => <li>{pt}</li>)}</ul>
        )}
        {p.links && p.links.length > 0 && (
          <p class="links">
            {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
          </p>
        )}
      </li>
    ))}
  </ol>
</Section>

<style>
  .list { list-style: none; margin: 0; padding: 0; max-width: var(--measure); }
  .project { padding: 2rem 0; border-top: 1px solid var(--rule); }
  .project:first-child { border-top: 0; padding-top: 0; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .status { font-family: var(--font-display); font-size: var(--step--1); white-space: nowrap; }

  /* Status colours: stable = calm teal, unstable = Hα red, decayed = muted */
  [data-status='stable']   .status { color: var(--h-beta); }
  [data-status='unstable'] .status { color: var(--h-alpha); }
  [data-status='decayed']  .status { color: var(--muted); }
  [data-status='decayed']  h2 { color: var(--muted); }

  .meta { margin: 0.3rem 0 0.8rem; color: var(--muted); font-size: var(--step--1); font-family: var(--font-display); }
  .summary { margin: 0; }
  .points { margin: 0.8rem 0 0; padding-left: 1.1rem; }
  .points li + li { margin-top: 0.35rem; }
  .links { display: flex; gap: 1.25rem; margin: 0.9rem 0 0; font-family: var(--font-display); }
</style>
