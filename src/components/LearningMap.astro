---
// src/components/LearningMap.astro
// -----------------------------------------------------------------------------
// "Things I'm learning", drawn as a slowly turning 3D constellation.
//
//   • Data lives in src/data/learning.ts (a flat list; each topic names its
//     parent). This file only draws it.
//   • Layout: each top-level branch gets its own direction from the centre,
//     spread evenly over a sphere. Its children fan out in a narrow cone
//     around that direction, further out; grandchildren in a narrower cone,
//     further still. So every branch reads as one cluster of stars.
//   • Rendering: plain <canvas>, no libraries. Points are rotated, then
//     projected with simple perspective; nearer things are drawn darker and
//     larger, farther things fainter. Colours come from the site's CSS
//     variables, so it follows the light/dark theme.
//   • Colour: each top-level branch gets its own colour (two palettes, one
//     tuned for paper, one for chalkboard), inherited by everything under it,
//     with a soft glow on the stars and a faint nebula behind each cluster.
//   • Interaction: drag (or swipe sideways) to turn it. Hover a star to
//     light its path back to the centre, dim the other branches, and read
//     its note. Hovering a branch also reveals its children's names.
//   • Reduced motion: no auto-rotation; dragging still works.
// -----------------------------------------------------------------------------
import { topics } from '../data/learning';
---
<figure class="map">
  <canvas class="sky" data-topics={JSON.stringify(topics)} aria-hidden="true"></canvas>
  <figcaption class="caption" aria-live="polite">
    <span class="caption-title"></span>
    <span class="caption-note pen">drag it around. hover a star.</span>
  </figcaption>

  <!-- Screen readers and no-JS visitors get the same content as a plain list. -->
  <ul class="sr-only">
    {topics.filter((t) => t.parent).map((t) => (
      <li>{t.label}{t.note ? `: ${t.note}` : ''}</li>
    ))}
  </ul>
</figure>

<style>
  .map { margin: 0; }
  .sky {
    display: block;
    width: 100%;
    height: clamp(420px, 74vh, 700px);
    cursor: grab;
    touch-action: pan-y;        /* vertical swipes still scroll the page */
  }
  .sky:active { cursor: grabbing; }

  /* One line under the map: the hovered topic (in its branch colour, set by
     JS), then its note in red pen. */
  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    min-height: 2.4rem;         /* reserve space so the page doesn't jump */
    margin-top: 0.5rem;
  }
  .caption-title {
    font-family: var(--f-big);
    font-weight: 700;
    font-variation-settings: 'wdth' 75;
    font-size: var(--s-1);
    transition: color 150ms;
  }
  .caption-title:empty { display: none; }
  .caption-note { font-size: 1.5rem; transform: rotate(-1deg); }
</style>

<script>
  interface Topic { id: string; label: string; parent?: string; note?: string; also?: string[]; colour?: string }
  type V3 = [number, number, number];

  // Node: a topic with its 3D position and, each frame, its projection.
  interface Node {
    t: Topic;
    depth: number;              // 0 = centre, 1 = branch, 2+ = deeper
    dir: V3;                    // unit direction from the centre
    p: V3;                      // position (unit sphere = outermost shell)
    parent: Node | null;
    kids: Node[];
    sx: number; sy: number;     // projected screen position (CSS px)
    sz: number;                 // depth after rotation: +1 near, −1 far
    k: number;                  // perspective scale
    branch: Node | null;        // the top-level branch it belongs to (null for the centre)
  }

  // ── Tuning ────────────────────────────────────────────────────────────────
  const SHELL = [0, 0.5, 0.82, 1.0, 1.12];   // radius of each depth's shell
  const CONE = [0, 0, 0.48, 0.3, 0.2];       // fan-out half-angle (rad) for children at each depth
  const SPIN = 0.07;                         // auto-rotation, rad/s
  const TILT = -0.32;                        // resting tilt toward the viewer
  const FOCAL = 3.2;                         // perspective strength (bigger = flatter)
  const HOVER_PX = 16;                       // how close the cursor must be to a star

  // ── Small vector helpers ─────────────────────────────────────────────────
  const add = (a: V3, b: V3): V3 => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
  const mul = (a: V3, s: number): V3 => [a[0] * s, a[1] * s, a[2] * s];
  const cross = (a: V3, b: V3): V3 =>
    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  const norm = (a: V3): V3 => mul(a, 1 / Math.hypot(...a));

  /** Two unit vectors perpendicular to d (and to each other). */
  function basis(d: V3): [V3, V3] {
    const helper: V3 = Math.abs(d[1]) < 0.9 ? [0, 1, 0] : [1, 0, 0];
    const u = norm(cross(d, helper));
    return [u, cross(d, u)];
  }

  /** n points spread evenly over a sphere (golden-angle spiral). */
  function fibonacci(n: number): V3[] {
    const out: V3[] = [];
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < n; i++) {
      const y = n === 1 ? 0 : 1 - (2 * (i + 0.5)) / n;
      const r = Math.sqrt(1 - y * y);
      out.push([Math.cos(golden * i) * r, y, Math.sin(golden * i) * r]);
    }
    return out;
  }

  // ── Build the tree and lay it out ────────────────────────────────────────
  function layout(topics: Topic[]): Node[] {
    const byId = new Map<string, Node>();
    for (const t of topics) {
      byId.set(t.id, { t, depth: 0, dir: [0, 0, 1], p: [0, 0, 0], parent: null, kids: [],
                       sx: 0, sy: 0, sz: 0, k: 1, branch: null });
    }
    let root: Node | null = null;
    for (const n of byId.values()) {
      const parent = n.t.parent ? byId.get(n.t.parent) : undefined;
      if (parent) { n.parent = parent; parent.kids.push(n); }
      else if (!root) root = n;
    }
    if (!root) return [];

    // Branches: spread evenly over the sphere.
    fibonacci(root.kids.length).forEach((d, i) => place(root!.kids[i], d, 1, root!.kids[i]));

    // Children fan out in a cone around their parent's direction.
    function place(n: Node, dir: V3, depth: number, branch: Node) {
      n.depth = depth;
      n.branch = branch;
      n.dir = dir;
      n.p = mul(dir, SHELL[Math.min(depth, SHELL.length - 1)]);
      const kids = n.kids;
      if (!kids.length) return;
      const cone = CONE[Math.min(depth + 1, CONE.length - 1)];
      const [u, v] = basis(dir);
      // Offset each fan by depth so neighbouring fans don't line up.
      const spin = depth * 1.3 + n.t.id.length;
      kids.forEach((kid, j) => {
        const a = spin + (2 * Math.PI * j) / kids.length;
        const theta = kids.length === 1 ? cone * 0.6 : cone;
        const off = add(mul(u, Math.cos(a) * Math.sin(theta)), mul(v, Math.sin(a) * Math.sin(theta)));
        place(kid, norm(add(mul(dir, Math.cos(theta)), off)), depth + 1, branch);
      });
    }

    // Only keep nodes connected to the centre (ignore typos in `parent`).
    const out: Node[] = [];
    (function walk(n: Node) { out.push(n); n.kids.forEach(walk); })(root);
    return out;
  }

  // ── One map instance per canvas ──────────────────────────────────────────
  function mount(canvas: HTMLCanvasElement) {
    const topics: Topic[] = JSON.parse(canvas.dataset.topics || '[]');
    const nodes = layout(topics);
    if (!nodes.length) return;
    const byId = new Map(nodes.map((n) => [n.t.id, n]));
    const links = nodes.flatMap((n) =>
      (n.t.also ?? []).filter((id) => byId.has(id)).map((id) => [n, byId.get(id)!] as const));

    const fig = canvas.closest('figure')!;
    const title = fig.querySelector('.caption-title') as HTMLElement;
    const note = fig.querySelector('.caption-note') as HTMLElement;
    const idleNote = note.textContent ?? '';
    const ctx = canvas.getContext('2d')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Branch colours, assigned in order. Light: saturated mid-tones that hold
    // up on white paper. Dark: brighter pastels, like coloured chalk.
    const PALETTE_LIGHT = ['#6a4cf5', '#0d9a85', '#e0870b', '#e04580', '#2f7de1', '#4c9a2a', '#e5603a', '#1597bf'];
    const PALETTE_DARK  = ['#b6a5ff', '#5ee3c9', '#ffc75e', '#ff90b6', '#8cbaff', '#a8e27c', '#ff9d78', '#7fd7f2'];
    const branches = nodes.filter((n) => n.depth === 1);

    // Theme colours, re-read when the colour scheme flips.
    let C = { ink: '#000', muted: '#666', rule: '#ddd', red: '#c00', paper: '#fff' };
    let P = PALETTE_LIGHT;
    const readColours = () => {
      const s = getComputedStyle(document.documentElement);
      const v = (name: string) => s.getPropertyValue(name).trim();
      C = { ink: v('--ink'), muted: v('--muted'), rule: v('--rule'), red: v('--red'), paper: v('--paper') };
      P = matchMedia('(prefers-color-scheme: dark)').matches ? PALETTE_DARK : PALETTE_LIGHT;
    };
    readColours();
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColours);

    // A node's colour: its branch's (a `colour` set on the branch in
    // learning.ts wins over the palette). The centre stays ink.
    const colourOf = (n: Node): string => {
      if (!n.branch) return C.ink;
      return n.branch.t.colour ?? P[branches.indexOf(n.branch) % P.length];
    };

    // Fonts for labels (the same families as the page).
    const fontBig = getComputedStyle(document.documentElement).getPropertyValue('--f-big').trim();

    // ── Size ─────────────────────────────────────────────────────────────
    let W = 0, H = 0, R = 0;
    const resize = () => {
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      // Outer shell radius on screen; narrower on phones to leave room for labels.
      R = Math.min(W * (W < 600 ? 0.38 : 0.44), H * 0.46);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    new ResizeObserver(resize).observe(canvas);

    // ── Rotation state: yaw (around vertical) and pitch (tilt) ──────────
    let yaw = 0.6, pitch = TILT;
    let vyaw = 0;                         // drag inertia
    let dragging = false, lastX = 0, lastY = 0;
    let hover: Node | null = null;
    let mouse: { x: number; y: number } | null = null;

    function project() {
      const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
      for (const n of nodes) {
        const [x, y, z] = n.p;
        // Yaw around Y, then pitch around X.
        const x1 = x * cy + z * sy;
        const z1 = -x * sy + z * cy;
        const y2 = y * cp - z1 * sp;
        const z2 = y * sp + z1 * cp;
        const k = FOCAL / (FOCAL - z2);   // perspective: nearer (z2 > 0) → bigger
        n.sx = W / 2 + x1 * R * k;
        n.sy = H / 2 - y2 * R * k;
        n.sz = z2;
        n.k = k;
      }
    }

    // Faint guide rings (equator + two meridians) so it reads as a sphere.
    function rings() {
      const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
      const ringR = SHELL[2];
      const planes: ((a: number) => V3)[] = [
        (a) => [Math.cos(a), 0, Math.sin(a)],          // equator
        (a) => [Math.cos(a), Math.sin(a), 0],          // meridian
        (a) => [0, Math.sin(a), Math.cos(a)],          // meridian
      ];
      ctx.lineWidth = 1;
      for (const ring of planes) {
        for (let i = 0; i < 96; i++) {
          if (i % 2) continue;                         // dotted
          const a0 = (i / 96) * 2 * Math.PI, a1 = ((i + 1) / 96) * 2 * Math.PI;
          const seg = [a0, a1].map((a) => {
            const [x, y, z] = mul(ring(a), ringR);
            const x1 = x * cy + z * sy, z1 = -x * sy + z * cy;
            const y2 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
            const k = FOCAL / (FOCAL - z2);
            return [W / 2 + x1 * R * k, H / 2 - y2 * R * k, z2];
          });
          ctx.globalAlpha = 0.25 + 0.35 * ((seg[0][2] + 1) / 2);
          ctx.strokeStyle = C.rule;
          ctx.beginPath();
          ctx.moveTo(seg[0][0], seg[0][1]);
          ctx.lineTo(seg[1][0], seg[1][1]);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
    }

    // Opacity from depth: far side fades to 25%, near side is full ink.
    const fade = (z: number) => 0.25 + 0.75 * ((z + 1) / 2);

    // Is n on the hovered node's path to the centre?
    const onPath = (n: Node) => { for (let h = hover; h; h = h.parent) if (h === n) return true; return false; };

    // '#rrggbb' → the same colour, fully transparent.
    const clear = (hex: string) => {
      const m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex);
      return m ? `rgba(${parseInt(m[1], 16)}, ${parseInt(m[2], 16)}, ${parseInt(m[3], 16)}, 0)` : 'transparent';
    };

    // On hover, everything outside the hovered branch steps back.
    const dimmed = (n: Node) => hover !== null && hover.depth > 0 && n.branch !== hover.branch && !onPath(n);

    function draw() {
      ctx.clearRect(0, 0, W, H);
      rings();
      const unit = R / 200;                  // scale glows with the sphere size

      // Nebulae: a soft wash of colour behind each branch cluster.
      for (const b of branches) {
        const r = 90 * b.k * unit;
        const g = ctx.createRadialGradient(b.sx, b.sy, 0, b.sx, b.sy, r);
        g.addColorStop(0, colourOf(b));
        // Fade to the same colour at zero alpha ('transparent' is black at
        // zero alpha, which greys the glow out on light paper).
        g.addColorStop(1, clear(colourOf(b)));
        ctx.globalAlpha = (dimmed(b) ? 0.03 : 0.14) * fade(b.sz);
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(b.sx, b.sy, r, 0, 2 * Math.PI); ctx.fill();
      }

      // Cross-links: faint dashed lines in the colour of where they start.
      ctx.setLineDash([2, 5]);
      ctx.lineWidth = 1.2;
      for (const [a, b] of links) {
        const lit = hover === a || hover === b;
        ctx.globalAlpha = lit ? 0.9 : hover ? 0.1 : 0.5 * fade((a.sz + b.sz) / 2);
        ctx.strokeStyle = colourOf(a);
        ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
      }
      ctx.setLineDash([]);

      // Branch lines, far ones first. Lines out of the centre fade from ink
      // into the branch colour; everything else is solid branch colour.
      const edges = nodes.filter((n) => n.parent).sort((a, b) => a.sz - b.sz);
      for (const n of edges) {
        const p = n.parent!;
        const lit = hover !== null && onPath(n);
        const col = colourOf(n);
        if (n.depth === 1) {
          const g = ctx.createLinearGradient(p.sx, p.sy, n.sx, n.sy);
          g.addColorStop(0, C.ink); g.addColorStop(1, col);
          ctx.strokeStyle = g;
        } else {
          ctx.strokeStyle = col;
        }
        ctx.globalAlpha = lit ? 1 : dimmed(n) ? 0.1 : 0.8 * fade((n.sz + p.sz) / 2);
        ctx.lineWidth = (lit ? 2.6 : n.depth === 1 ? 1.8 : 1.2) * Math.max(1, unit * 0.8);
        ctx.shadowColor = col;
        ctx.shadowBlur = lit ? 10 : 0;
        ctx.beginPath(); ctx.moveTo(p.sx, p.sy); ctx.lineTo(n.sx, n.sy); ctx.stroke();
      }
      ctx.shadowBlur = 0;

      // Stars, far ones first so near ones sit on top. Each glows in its colour.
      const order = [...nodes].sort((a, b) => a.sz - b.sz);
      for (const n of order) {
        const col = colourOf(n);
        const base = n.depth === 0 ? 7 : n.depth === 1 ? 6 : 3.6;
        const r = base * n.k * Math.max(1, unit * 0.85) * (hover === n ? 1.5 : 1);
        const dim = dimmed(n);
        ctx.globalAlpha = dim ? 0.18 : fade(n.sz);
        ctx.fillStyle = col;
        ctx.shadowColor = col;
        ctx.shadowBlur = dim || n.depth === 0 ? 0 : (n.depth === 1 ? 16 : 8) * fade(n.sz);
        ctx.beginPath(); ctx.arc(n.sx, n.sy, r, 0, 2 * Math.PI); ctx.fill();
        if (n.depth === 0) {               // the centre gets a hollow ring around it
          ctx.strokeStyle = col; ctx.lineWidth = 1.2;
          ctx.beginPath(); ctx.arc(n.sx, n.sy, r + 6, 0, 2 * Math.PI); ctx.stroke();
        }
      }
      ctx.shadowBlur = 0;

      // Labels: the centre and branches always; deeper topics only when
      // they (or their branch) are hovered, to keep it uncluttered. A thin
      // paper-coloured outline keeps text readable over lines.
      ctx.textBaseline = 'middle';
      ctx.lineJoin = 'round';
      for (const n of order) {
        const show = n.depth <= 1 || hover === n || n.parent === hover || onPath(n);
        if (!show) continue;
        const lit = hover !== null && onPath(n);
        const size = (n.depth <= 1 ? 17 : 14) * Math.min(1.25, Math.max(1, unit * 0.9));
        ctx.font = `${n.depth <= 1 ? 750 : 550} ${Math.round(size * Math.min(1.15, n.k))}px ${fontBig}`;
        ctx.globalAlpha = lit ? 1 : dimmed(n) ? 0.22 : n.depth <= 1 ? fade(n.sz) : 0.95;
        // Labels sit on the outward side of their star.
        const right = n.sx >= W / 2;
        ctx.textAlign = n.depth === 0 ? 'center' : right ? 'left' : 'right';
        const gap = 10 * Math.max(1, unit * 0.8);
        let tx = n.sx + (n.depth === 0 ? 0 : right ? gap : -gap);
        // Keep labels inside the canvas (narrow phone screens).
        const tw = ctx.measureText(n.t.label).width;
        const lo = ctx.textAlign === 'left' ? tx : ctx.textAlign === 'right' ? tx - tw : tx - tw / 2;
        if (lo < 4) tx += 4 - lo;
        if (lo + tw > W - 4) tx -= lo + tw - (W - 4);
        const ty = n.sy + (n.depth === 0 ? -22 : 0);
        ctx.strokeStyle = C.paper; ctx.lineWidth = 4;
        ctx.strokeText(n.t.label, tx, ty);
        ctx.fillStyle = colourOf(n);
        ctx.fillText(n.t.label, tx, ty);
      }
      ctx.globalAlpha = 1;
    }

    // ── Hover ────────────────────────────────────────────────────────────
    function pickHover() {
      let best: Node | null = null, bestD = HOVER_PX;
      if (mouse && !dragging) {
        for (const n of nodes) {
          const d = Math.hypot(n.sx - mouse.x, n.sy - mouse.y);
          // Prefer nearer stars when two overlap on screen.
          if (d - n.sz * 3 < bestD) { best = n; bestD = d - n.sz * 3; }
        }
      }
      if (best !== hover) {
        hover = best;
        title.textContent = hover ? hover.t.label : '';
        title.style.color = hover ? colourOf(hover) : '';
        note.textContent = hover ? (hover.t.note ?? '') : idleNote;
      }
    }

    // ── Pointer: drag to turn ────────────────────────────────────────────
    const local = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true; lastX = e.clientX; lastY = e.clientY; vyaw = 0;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      mouse = local(e);
      if (!dragging) return;
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      lastX = e.clientX; lastY = e.clientY;
      yaw += dx * 0.008;
      vyaw = dx * 0.008 * 60;               // remembered for the fling
      if (e.pointerType === 'mouse') {      // tilt only with a mouse (touch scrolls)
        pitch = Math.max(-1.2, Math.min(1.2, pitch + dy * 0.006));
      }
    });
    const release = () => { dragging = false; };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('pointerleave', () => { mouse = null; });

    // ── Loop (only while visible) ────────────────────────────────────────
    let visible = false, last = performance.now();
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) { last = performance.now(); requestAnimationFrame(frame); }
    }).observe(canvas);

    function frame(now: number) {
      if (!visible) return;
      const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
      last = now;
      if (!dragging) {
        // Fling decays; auto-spin resumes underneath it (and pauses on hover).
        vyaw *= Math.pow(0.04, dt);
        const auto = still || hover ? 0 : SPIN;
        yaw += (auto + vyaw) * dt;
        pitch += (TILT - pitch) * Math.min(1, dt * 0.6);   // drift back to rest tilt
      }
      project();
      pickHover();
      draw();
      requestAnimationFrame(frame);
    }
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.sky').forEach(mount);
</script>
