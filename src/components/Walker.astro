---
// src/components/Walker.astro
// -----------------------------------------------------------------------------
// A small pixel Jotaro who walks along the bottom of every page.
//
//   • Every so often he stops, Star Platinum appears in front of him and
//     throws an ORA rush, then fades out and he walks on.
//   • Click him: he stops and says a line. Click again for another line.
//   • Click him three times quickly: "Star Platinum: The World!". Time stops
//     (the page inverts) and only he keeps moving, then time resumes.
//
// How it works:
//   • Frames are cut straight out of the two sprite sheets in public/sprites/
//     using the rectangles below. The PNGs are never edited.
//   • Each sheet has a solid background colour. On load, every pixel close to
//     that colour is made transparent (a chroma key), so the sprites sit
//     cleanly on both the paper (light) and chalkboard (dark) themes.
//   • One <canvas> fixed to the bottom of the viewport draws everything with
//     image smoothing off. The canvas ignores the mouse; only a small
//     invisible button that follows Jotaro takes clicks, so the rest of the
//     page underneath stays clickable.
//   • Hidden entirely for visitors who ask for reduced motion.
//
// Sprites: Capcom (JoJo's Bizarre Adventure, 1998), ripped by Dazz & Fret,
// The Spriters Resource. Credited in the footer.
// -----------------------------------------------------------------------------
---
<div class="walker" id="walker" aria-hidden="true">
  <canvas id="walker-canvas"></canvas>
  <!-- Invisible hitbox that follows Jotaro; the only part that takes clicks. -->
  <button class="hit" id="walker-hit" tabindex="-1" aria-hidden="true"></button>
  <div class="ora" id="walker-ora">ORA ORA ORA!</div>
  <div class="say" id="walker-say"></div>
</div>

<style>
  .walker {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    height: 100px;            /* JS resets this to fit the chosen sprite scale */
    pointer-events: none;     /* decoration: clicks go straight through... */
    z-index: 5;               /* under the header (10) and the easter egg (50) */
  }
  canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }

  /* ...except on Jotaro himself. JS moves and sizes this box every frame. */
  .hit {
    position: absolute;
    left: 0; bottom: 0;
    width: 0; height: 0;
    padding: 0; border: 0; background: none;
    pointer-events: auto;
    cursor: pointer;
  }

  /* ORA shout. JS sets left/bottom; transform is left free for the shake. */
  .ora {
    position: absolute;
    left: 0; bottom: 0;
    font-family: var(--f-big);
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    color: var(--red);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 120ms;
  }
  .ora.on { opacity: 1; animation: ora-shake 110ms steps(2) infinite; }
  @keyframes ora-shake {
    from { transform: rotate(-6deg) translate(0, 0); }
    to   { transform: rotate(-4deg) translate(2px, -2px); }
  }

  /* Speech bubble for his lines: a margin note on paper, with a little tail. */
  .say {
    position: absolute;
    left: 0; bottom: 0;
    max-width: 16rem;
    padding: 0.35rem 0.7rem 0.45rem;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    font-family: var(--f-pen);
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 140ms, transform 140ms;
  }
  .say::after {             /* the tail, pointing down at his head */
    content: '';
    position: absolute;
    left: var(--tail, 50%); bottom: -7px;
    width: 10px; height: 10px;
    background: var(--paper);
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    transform: translateX(-50%) rotate(45deg);
  }
  .say.on { opacity: 1; transform: none; }

  /* Time stop: invert the whole page, the way the anime does it. */
  :global(html) { transition: filter 450ms ease; }
  :global(html.za-warudo) { filter: invert(1); }   /* a colour negative */

  @media (prefers-reduced-motion: reduce) { .walker { display: none; } }
</style>

<script>
  // ── Size ──────────────────────────────────────────────────────────────────
  // Screen px per sprite px. 1 = sheet size (~66 px tall), 2 = double.
  // Snapped to whole device pixels at runtime so the pixels stay square.
  const SIZE_DESKTOP = 1.25;
  const SIZE_PHONE = 1;              // under 640 px wide

  // ── Lines he says when clicked (cycled in order, starting at random) ─────
  const LINES = [
    'Yare yare daze.',
    'Good grief.',
    'Urusai.',
    '…',
    'Go read a lecture.',
    "You're still here? Good grief.",
  ];

  // ── Sprite sheet data ─────────────────────────────────────────────────────
  // A frame is [x, y, w, h] in sheet pixels. Every frame's bottom edge is the
  // feet line, so frames are drawn bottom-aligned to the ground.
  type Rect = [number, number, number, number];
  interface Sheet {
    src: string;
    bg: [number, number, number];  // background colour to key out
    hard: number;                  // colour distance below this → transparent
    soft: number;                  // above this → fully opaque (between = edge)
    spill: 'r' | 'g' | 'b';        // channel the background tints edges with
  }

  const SHEETS: Record<'jotaro' | 'star', Sheet> = {
    jotaro: { src: '/sprites/jotaro.png',        bg: [128, 128, 255], hard: 40, soft: 110, spill: 'b' },
    star:   { src: '/sprites/star-platinum.png', bg: [24, 251, 21],   hard: 90, soft: 200, spill: 'g' },
  };

  // Jotaro's sheet is a grid of 75 px cells.
  const cell = (col: number, top: number): Rect => [75 * col, top, 75, 66];
  const JOTARO = {
    // Walk cycle: last 4 cells of row 1, then first 4 cells of row 2.
    walk: [cell(6, 2), cell(7, 2), cell(8, 2), cell(9, 2), cell(0, 80), cell(1, 80), cell(2, 80), cell(3, 80)],
    // Standing (coat flapping): first 6 cells of row 1.
    idle: [0, 1, 2, 3, 4, 5].map((c) => cell(c, 2)),
  };

  // Star Platinum's sheet is not a grid; these were measured by hand.
  const STAR = {
    appear: [[8, 125, 31, 59], [45, 125, 28, 59], [80, 125, 31, 59], [120, 125, 31, 59]] as Rect[],
    rush:   [[36, 272, 80, 64], [116, 272, 65, 64], [181, 272, 82, 64],
             [263, 272, 77, 64], [340, 272, 83, 64], [423, 272, 72, 64]] as Rect[],
  };

  // ── Behaviour tuning (sprite px and seconds) ─────────────────────────────
  const SPEED = 30;              // walking speed, sprite px per second
  const WALK_FPS = 10;
  const IDLE_FPS = 8;
  const RUSH_FPS = 18;
  const SUMMON_T = 0.35;         // Star Platinum fades in
  const RUSH_T = 2.4;            // length of the barrage
  const RECALL_T = 0.3;          // Star Platinum fades out
  const TALK_T = 2.6;            // how long a clicked line stays up
  const CALL_T = 0.9;            // "Star Platinum: The World!" before time stops
  const STOPPED_T = 3;           // how long time stays stopped
  const RESUME_T = 1.6;          // "Time resumes." afterwards
  const TRIPLE_MS = 900;         // three clicks within this window = time stop
  const STAR_ALPHA = 0.92;       // stands are a touch see-through
  const STAR_OFFSET = 2;         // where the Stand stands, relative to Jotaro's centre
  const ROOM = 110;              // free space needed in front before a rush
  const ROW_H = 72;              // canvas height in sprite px (tallest frame + margin)
  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  // ── Chroma key: sheet image → canvas with a transparent background ───────
  function keyed(img: HTMLImageElement, s: Sheet): HTMLCanvasElement {
    const c = document.createElement('canvas');
    c.width = img.naturalWidth;
    c.height = img.naturalHeight;
    const ctx = c.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(img, 0, 0);
    const data = ctx.getImageData(0, 0, c.width, c.height);
    const p = data.data;
    const ch = { r: 0, g: 1, b: 2 }[s.spill];
    for (let i = 0; i < p.length; i += 4) {
      const dr = p[i] - s.bg[0], dg = p[i + 1] - s.bg[1], db = p[i + 2] - s.bg[2];
      const a = (Math.sqrt(dr * dr + dg * dg + db * db) - s.hard) / (s.soft - s.hard);
      if (a < 0.5) { p[i + 3] = 0; continue; }       // background: gone
      if (a < 1) {
        // Edge pixel: still tinted by the background. Pull the tint channel
        // down toward the other two (despill). Only edges, so Jotaro's blue
        // coat and Star Platinum's purple keep their real colours.
        const others = [p[i], p[i + 1], p[i + 2]].filter((_, k) => k !== ch);
        const cap = Math.max(...others) + (s.spill === 'b' ? 40 : 0);
        p[i + ch] = Math.min(p[i + ch], cap);
      }
      p[i + 3] = 255;                                 // hard edge: pixel art, no halo
    }
    ctx.putImageData(data, 0, 0);
    return c;
  }

  function load(src: string): Promise<HTMLImageElement> {
    return new Promise((ok, fail) => {
      const img = new Image();
      img.onload = () => ok(img);
      img.onerror = fail;
      img.src = src;
    });
  }

  async function start() {
    const root = document.getElementById('walker');
    const canvas = document.getElementById('walker-canvas') as HTMLCanvasElement | null;
    const hit = document.getElementById('walker-hit');
    const ora = document.getElementById('walker-ora');
    const say = document.getElementById('walker-say');
    if (!root || !canvas || !hit || !ora || !say) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const [jImg, sImg] = await Promise.all([load(SHEETS.jotaro.src), load(SHEETS.star.src)]);
    const jSheet = keyed(jImg, SHEETS.jotaro);
    const sSheet = keyed(sImg, SHEETS.star);
    const ctx = canvas.getContext('2d')!;

    // ── Sizing ─────────────────────────────────────────────────────────────
    let W = 0, H = 0, S = 1;       // S = CSS px per sprite px
    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const want = innerWidth < 640 ? SIZE_PHONE : SIZE_DESKTOP;
      // Whole device pixels per sprite pixel, so every pixel is the same size.
      S = Math.max(1, Math.round(want * dpr)) / dpr;
      H = Math.round(ROW_H * S);
      root!.style.height = `${H}px`;
      document.body.style.paddingBottom = `${H}px`;   // never cover the last line
      W = canvas!.clientWidth;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = false;
    }
    resize();
    addEventListener('resize', resize);

    // ── State ─────────────────────────────────────────────────────────────
    // walk → summon → rush → recall → walk           (automatic, on a timer)
    // walk → talk → walk                              (one click)
    // any  → call → stopped → resume → walk           (three quick clicks)
    type State = 'walk' | 'summon' | 'rush' | 'recall' | 'talk' | 'call' | 'stopped' | 'resume';
    let state: State = 'walk';
    let t = 0;                                  // seconds in current state
    let clock = 0;                              // seconds since start (frame picking)
    let x = rand(0.15, 0.85) * W;               // Jotaro's centre, CSS px
    let dir: 1 | -1 = Math.random() < 0.5 ? 1 : -1;
    let walked = 0;                             // seconds walked since last rush
    let nextRush = rand(5, 10);                 // first rush comes a bit sooner
    let line = Math.floor(Math.random() * LINES.length);
    let clicks: number[] = [];                  // recent click times, for the triple
    let last = performance.now();

    const pick = (frames: Rect[], fps: number) =>
      frames[Math.floor(Math.max(0, clock) * fps) % frames.length];

    function go(next: State) { state = next; t = 0; }

    function speak(text: string | null) {
      if (text === null) { say!.classList.remove('on'); return; }
      say!.textContent = text;
      say!.classList.add('on');
    }

    // ── Clicks ────────────────────────────────────────────────────────────
    hit.addEventListener('click', () => {
      const now = performance.now();
      clicks = clicks.filter((c) => now - c < TRIPLE_MS).concat(now);

      // Three quick clicks: stop time (unless it's already happening).
      if (clicks.length >= 3 && !['call', 'stopped', 'resume'].includes(state)) {
        clicks = [];
        speak('Star Platinum: The World!');
        go('call');
        return;
      }
      // One click: stop and say the next line. Not mid-rush or mid-time-stop.
      if (state === 'walk' || state === 'talk') {
        line = (line + 1) % LINES.length;
        speak(LINES[line]);
        go('talk');
      }
    });

    // ── Update ────────────────────────────────────────────────────────────
    function walkStep(dt: number) {
      x += dir * SPEED * S * dt;
      const margin = 30 * S;
      if (x > W - margin) { x = W - margin; dir = -1; }
      if (x < margin)     { x = margin;     dir = 1; }
    }

    function update(dt: number) {
      t += dt;
      clock += dt;
      switch (state) {
        case 'walk': {
          walkStep(dt);
          walked += dt;
          const room = dir === 1 ? W - x : x;
          if (walked > nextRush && room > ROOM * S) go('summon');
          break;
        }
        case 'summon':  if (t > SUMMON_T) go('rush'); break;
        case 'rush':    if (t > RUSH_T) go('recall'); break;
        case 'recall':
          if (t > RECALL_T) { walked = 0; nextRush = rand(9, 18); go('walk'); }
          break;
        case 'talk':
          if (t > TALK_T) { speak(null); go('walk'); }
          break;
        case 'call':
          if (t > CALL_T) {
            speak(null);
            document.documentElement.classList.add('za-warudo');
            go('stopped');
          }
          break;
        case 'stopped':
          walkStep(dt);                         // only he can move in stopped time
          if (t > STOPPED_T) {
            document.documentElement.classList.remove('za-warudo');
            speak('Time resumes.');
            go('resume');
          }
          break;
        case 'resume':
          if (t > RESUME_T) { speak(null); walked = 0; go('walk'); }
          break;
      }
    }

    // ── Draw ──────────────────────────────────────────────────────────────
    // ox is a frame's left edge relative to Jotaro's centre, in sprite px.
    function blit(sheet: HTMLCanvasElement, r: Rect, ox: number, oy = 0) {
      ctx.drawImage(sheet, r[0], r[1], r[2], r[3], ox, -r[3] + oy, r[2], r[3]);
    }

    // Centre an overlay element horizontally on cx, kept inside the viewport.
    function place(el: HTMLElement, cx: number, bottom: number) {
      const w = el.offsetWidth;
      const left = Math.min(W - w - 8, Math.max(8, cx - w / 2));
      el.style.left = `${Math.round(left)}px`;
      el.style.bottom = `${Math.round(bottom)}px`;
      return left;
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      ctx.save();
      // Origin at Jotaro's feet; 1 unit = 1 sprite px; mirror when facing left.
      ctx.translate(Math.round(x), H - 2 * S);
      ctx.scale(dir * S, S);

      const moving = state === 'walk' || state === 'stopped';
      blit(jSheet, moving ? pick(JOTARO.walk, WALK_FPS) : pick(JOTARO.idle, IDLE_FPS), -37);

      if (state === 'summon' || state === 'rush' || state === 'recall') {
        let alpha = STAR_ALPHA;
        if (state === 'summon') alpha *= t / SUMMON_T;
        if (state === 'recall') alpha *= 1 - t / RECALL_T;
        ctx.globalAlpha = Math.max(0, alpha);
        if (state === 'summon') {
          blit(sSheet, pick(STAR.appear, 12), STAR_OFFSET + 6);
        } else {
          // Tiny random shake sells the impact.
          const jx = state === 'rush' ? Math.round(rand(-1, 1)) : 0;
          const jy = state === 'rush' ? Math.round(rand(-1, 0)) : 0;
          blit(sSheet, pick(STAR.rush, RUSH_FPS), STAR_OFFSET + jx, jy);
        }
        ctx.globalAlpha = 1;
      }
      ctx.restore();

      // Hitbox over his body (about 30 × 62 sprite px).
      hit!.style.width = `${30 * S}px`;
      hit!.style.height = `${62 * S}px`;
      hit!.style.left = `${Math.round(x - 15 * S)}px`;
      hit!.style.bottom = `${2 * S}px`;

      // ORA shout above the Stand while the rush is on.
      const shouting = state === 'rush';
      ora!.classList.toggle('on', shouting);
      if (shouting) place(ora!, x + dir * 40 * S, 64 * S);

      // Speech bubble above his head, tail pointing at him.
      if (say!.classList.contains('on')) {
        const left = place(say!, x, 66 * S);
        say!.style.setProperty('--tail', `${Math.round(x - left)}px`);
      }
    }

    function frame(now: number) {
      // Clamp dt: never negative (the first rAF timestamp can predate `last`),
      // and capped so a backgrounded tab doesn't teleport him on return.
      const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
      last = now;
      update(dt);
      draw();
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  start().catch(() => { /* sprites missing: stay invisible rather than break the page */ });
</script>
