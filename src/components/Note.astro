---
// src/components/Note.astro
// -----------------------------------------------------------------------------
// A red-pen margin note, Tufte-style.
//   Wide screens:   floats out into the right margin, level with the
//                   paragraph that comes right after it.
//   Narrow screens: sits inline above that paragraph, indented.
// Use it inside a .column. The jokes live here so the main text can stay
// clear and professional.
//
//   <Note>a red-pen remark</Note>   ← put the note FIRST
//   <p>The sentence it's about.</p>
// -----------------------------------------------------------------------------
interface Props { tilt?: number }   // degrees of rotation, for a hand-written feel
const { tilt = -2 } = Astro.props;
---
<aside class="note pen" style={`--tilt:${tilt}deg`}><slot /></aside>

<style>
  .note {
    display: block;
    margin: 0 0 0.6rem 1rem;
    font-size: 1.65rem;
    transform: rotate(var(--tilt));
    transform-origin: left top;
  }
  /* Room for the margin column exists from ~1100px: float the note into it. */
  @media (min-width: 1100px) {
    .note {
      float: right;
      clear: right;
      width: var(--margin-w);
      margin: 0 calc(-1 * (var(--margin-w) + 3rem)) 1rem 0;
    }
  }
</style>
