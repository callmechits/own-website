---
// src/components/Tile.astro
// -----------------------------------------------------------------------------
// One element tile: atomic number, symbol, name. Used by the home table, the
// sub-page headers, and the friends page.
//
// Renders as <a> when it has an href, otherwise as a <div> (undiscovered
// elements and decorative headers are not links).
// -----------------------------------------------------------------------------
interface Props {
  n?: number | string;
  sym: string;
  name: string;
  cat: string;               // work | life | media | links | unknown
  href?: string;
  external?: boolean;
  size?: 'md' | 'lg';        // lg = page-header tile
  class?: string;
  style?: string;
  [key: `data-${string}`]: string | number | undefined; // pass-through for the table script
}

const { n, sym, name, cat, href, external, size = 'md', class: cls, style, ...rest } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag
  class:list={['tile', `tile--${size}`, cls]}
  data-cat={cat}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  style={style}
  {...rest}
>
  {n !== undefined && <span class="n">{n}</span>}
  <span class="sym">{sym}</span>
  <span class="name">{name}</span>
</Tag>

<style>
  .tile {
    /* Square tile; the grid decides its width */
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1;
    padding: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  /* The emission line: a thin vertical stroke in the category colour,
     set at the left edge like a line on a spectrograph plate. */
  .tile::before {
    content: '';
    position: absolute;
    inset: 18% auto 18% 0;
    width: 3px;
    background: var(--c);
    border-radius: 0 2px 2px 0;
  }

  .n {
    position: absolute;
    top: 0.35rem;
    left: 0.55rem;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .sym {
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .name {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    color: var(--muted);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Links react; the line colour floods into the border. */
  a.tile:hover,
  a.tile:focus-visible {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 9%, var(--surface));
  }

  /* Undiscovered elements: dashed outline, faded, like a predicted slot. */
  .tile[data-cat='unknown'] {
    background: transparent;
    border-style: dashed;
  }
  .tile[data-cat='unknown'] .sym { color: var(--muted); font-weight: 500; }

  /* Large header tile on sub-pages */
  .tile--lg { width: 6.5rem; flex-shrink: 0; }
  .tile--lg .sym { font-size: 2.6rem; }
  .tile--lg .n { font-size: 0.8rem; }
</style>
